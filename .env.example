# Copia este archivo a .env.local para leer el catálogo desde el Supabase del CMS.
# Sin estas variables el sitio usa src/lib/marketplace/catalog.json.
# Sólo servidor: nunca les pongas el prefijo NEXT_PUBLIC_.
SUPABASE_URL=http://127.0.0.1:54721
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_TENANT_SLUG=demo
